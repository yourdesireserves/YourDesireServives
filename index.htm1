<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>YourDesireServices</title>

<style>
* {
box-sizing: border-box;
margin: 0;
padding: 0;
font-family: Arial, sans-serif;
}

body {
background: #f5f9ff;
color: #172033;
}

header {
background: #ffffff;
padding: 18px 7%;
display: flex;
justify-content: space-between;
align-items: center;
border-bottom: 1px solid #e4eaf2;
}

.logo {
font-size: 24px;
font-weight: bold;
color: #1264d8;
}

nav a {
text-decoration: none;
color: #172033;
margin-left: 22px;
font-weight: 600;
}

.hero {
background: linear-gradient(135deg, #0b63ce, #2487f5);
color: white;
text-align: center;
padding: 85px 20px;
}

.hero h1 {
font-size: 46px;
margin-bottom: 18px;
}

.hero p {
font-size: 19px;
margin-bottom: 30px;
}

.search-box {
background: white;
max-width: 650px;
margin: auto;
padding: 10px;
border-radius: 12px;
display: flex;
gap: 10px;
}

.search-box input {
flex: 1;
border: none;
outline: none;
padding: 15px;
font-size: 16px;
}

.search-box button {
background: #1264d8;
color: white;
border: none;
padding: 15px 25px;
border-radius: 8px;
cursor: pointer;
font-weight: bold;
}

.section {
padding: 60px 7%;
text-align: center;
}

.section h2 {
font-size: 32px;
margin-bottom: 12px;
}

.section p {
color: #667085;
margin-bottom: 35px;
}

.services {
display: grid;
grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
gap: 20px;
}

.service-card {
background: white;
padding: 30px 20px;
border-radius: 14px;
box-shadow: 0 5px 20px rgba(0,0,0,0.06);
transition: 0.2s;
}

.service-card:hover {
transform: translateY(-5px);
}

.service-icon {
font-size: 38px;
margin-bottom: 15px;
}

.service-card h3 {
margin-bottom: 10px;
}

.service-card button {
margin-top: 15px;
background: #1264d8;
color: white;
border: none;
padding: 10px 18px;
border-radius: 7px;
cursor: pointer;
}

.provider {
background: white;
margin: 20px 7% 60px;
padding: 45px;
border-radius: 18px;
text-align: center;
box-shadow: 0 5px 20px rgba(0,0,0,0.06);
}

.provider button {
background: #1264d8;
color: white;
border: none;
padding: 14px 25px;
border-radius: 8px;
font-weight: bold;
cursor: pointer;
}

footer {
background: #10233f;
color: white;
text-align: center;
padding: 30px;
}

@media (max-width: 600px) {
.hero h1 {
font-size: 34px;
}

nav {
display: none;
}

.search-box {
flex-direction: column;
}
}
</style>
</head>

<body>

<header>
<div class="logo">YourDesireServices</div>

<nav>
<a href="#">Home</a>
<a href="#services">Services</a>
<a href="#providers">Providers</a>
<a href="#contact">Contact</a>
</nav>
</header>

<section class="hero">

<h1>Find the Service You Need</h1>

<p>
Discover trusted service providers and book what you need in one place.
</p>

<div class="search-box">
<input
type="text"
placeholder="What service are you looking for?"
>

<button onclick="searchService()">
Search
</button>
</div>

</section>

<section class="section" id="services">

<h2>Explore Services</h2>

<p>Find professionals for everyday services.</p>

<div class="services">

<div class="service-card">
<div class="service-icon">💇🏽‍♀️</div>
<h3>Beauty</h3>
<p>Hair, nails, makeup and more.</p>
<button>View Services</button>
</div>

<div class="service-card">
<div class="service-icon">🚗</div>
<h3>Auto</h3>
<p>Car care and automotive services.</p>
<button>View Services</button>
</div>

<div class="service-card">
<div class="service-icon">🏠</div>
<h3>Home</h3>
<p>Cleaning, repairs and home services.</p>
<button>View Services</button>
</div>

<div class="service-card">
<div class="service-icon">🍽️</div>
<h3>Food</h3>
<p>Food, catering and personal chefs.</p>
<button>View Services</button>
</div>

<div class="service-card">
<div class="service-icon">📦</div>
<h3>Delivery</h3>
<p>Local delivery and moving services.</p>
<button>View Services</button>
</div>

<div class="service-card">
<div class="service-icon">💻</div>
<h3>Technology</h3>
<p>Tech help, websites and digital services.</p>
<button>View Services</button>
</div>

</div>

</section>

<section class="provider" id="providers">

<h2>Offer Your Services</h2>

<p>
Join YourDesireServices and connect with customers looking for your skills.
</p>

<button onclick="becomeProvider()">
Become a Service Provider
</button>

</section>

<footer id="contact">

<p>© 2026 YourDesireServices</p>
<p>Connecting people with the services they need.</p>

</footer>

<script>

function searchService() {
alert("Service search coming soon!");
}

function becomeProvider() {
alert("Provider registration coming soon!");
}

</script>

</body>
</html>
